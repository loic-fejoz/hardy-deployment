- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Burst Tagger',\n            in_sig=[np.uint8],\n\
      \            out_sig=[np.uint8]\n        )\n        self.length_tag_name = pmt.intern('packet_len')\n\
      \        self.sob_key = pmt.intern('tx_sob')\n        self.eob_key = pmt.intern('tx_eob')\n\
      \n    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        out0 = output_items[0]\n        n = len(in0)\n        tags = self.get_tags_in_window(0,\
      \ 0, n)\n        for t in tags:\n            if pmt.symbol_to_string(t.key)\
      \ == 'packet_len':\n                pkt_len = pmt.to_long(t.value)\n       \
      \         self.add_item_tag(0, t.offset, self.sob_key, pmt.PMT_T)\n        \
      \        self.add_item_tag(0, t.offset + pkt_len - 1, self.eob_key, pmt.PMT_T)\n\
      \        out0[:n] = in0[:n]\n        return n\n"
    affinity: ''
    alias: ''
    comment: Add tx_sob and tx_eob tags for USRP burst transmission
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Burst Tagger', 'blk', [], [('0', 'byte', 1)], [('0', 'byte', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 288.0]
    rotation: 0
    state: enabled

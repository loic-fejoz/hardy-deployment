options:
  parameters:
    alias: ''
    author: F4JXQ
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: UDP GFSK 9600 Transceiver with G3RUH Scrambling, NRZ-I and UDP Socket
      Interface
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: udp_gfsk
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: UDP_GFSK
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 12.0]
    rotation: 0
    state: enabled


  id: pdu_pdu_lambda
  parameters:
    affinity: ''
    alias: ''
    comment: Prepend 32 bytes of 0x55 preamble
    fn: 'lambda p: pmt.cons(pmt.car(p), pmt.init_u8vector(32 + len(pmt.u8vector_elements(pmt.cdr(p))),
      [0x55]*32 + list(pmt.u8vector_elements(pmt.cdr(p)))))'
    key: pmt.intern("key")
    maxoutbuf: '0'
    metadict: Raw Message
    minoutbuf: '0'
  states:

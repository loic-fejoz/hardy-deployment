    fn: 'lambda p: pmt.cons(pmt.car(p), pmt.init_u8vector(len(pmt.u8vector_elements(pmt.cdr(p)))
      + 64, list(pmt.u8vector_elements(pmt.cdr(p))) + [0x55]*64))'
    key: pmt.intern("key")
    maxoutbuf: '0'
    metadict: Raw Message
    minoutbuf: '0'
  states:
